{
  "$description": "Indurex UI design tokens — the single source of truth. Only tokens the product actually uses. Generates ui/styles/tokens.css (npm run tokens). Colour names follow shadcn/ui. State colours are ONE token each; tints/borders come from opacity modifiers (bg-kev/10, border-kev/30).",
  "primitives": {
    "gray": {
      "0": "#FFFFFF",
      "25": "#F7F8FA",
      "50": "#F0F2F5",
      "100": "#E3E6EB",
      "200": "#CDD2DA",
      "400": "#8A93A1",
      "500": "#6B7482",
      "600": "#656D7B",
      "800": "#2A3039",
      "850": "#20252D",
      "900": "#181C22",
      "950": "#111418",
      "975": "#0E1114",
      "1000": "#0B0D10"
    },
    "blue": { "400": "#66A6FC", "600": "#3873C0" },
    "red": { "400": "#FE7173", "700": "#A2242F" },
    "orange": { "400": "#EC873A", "700": "#8C4501" },
    "yellow": { "400": "#C1A222", "700": "#6D5901" },
    "amber": { "400": "#D6972B", "700": "#7A5204" },
    "green": { "400": "#3EBE8B", "700": "#046C4A" },
    "violet": { "400": "#A493FA", "700": "#5B4B9B" },
    "magenta": { "400": "#F767C2", "700": "#972371" },
    "slate": { "400": "#92A6C2", "700": "#4D5C71" },
    "alpha": { "white-6": "#FFFFFF0F", "black-5": "#0B0D100D" }
  },
  "color": {
    "background": {
      "light": "gray.25",
      "dark": "gray.1000",
      "description": "App canvas"
    },
    "foreground": {
      "light": "gray.950",
      "dark": "gray.100",
      "description": "Primary text"
    },
    "card": {
      "light": "gray.0",
      "dark": "gray.950",
      "description": "Panels, tables, cards"
    },
    "popover": {
      "light": "gray.0",
      "dark": "gray.850",
      "description": "Menus, tooltips"
    },
    "primary": {
      "light": "blue.600",
      "dark": "blue.400",
      "description": "Interaction only — never encodes status"
    },
    "primary-foreground": { "light": "gray.0", "dark": "gray.1000" },
    "secondary": {
      "light": "gray.100",
      "dark": "gray.900",
      "description": "Secondary buttons"
    },
    "muted": {
      "light": "gray.50",
      "dark": "gray.975",
      "description": "Inputs, table header, wells"
    },
    "muted-foreground": {
      "light": "gray.600",
      "dark": "gray.400",
      "description": "Metadata, placeholders, Not assessed"
    },
    "accent": {
      "light": "alpha.black-5",
      "dark": "alpha.white-6",
      "description": "Hover surface"
    },
    "border": { "light": "gray.200", "dark": "gray.800" },
    "input": {
      "light": "gray.500",
      "dark": "gray.500",
      "description": "Form control boundary (≥3:1)"
    },
    "ring": {
      "light": "blue.600",
      "dark": "blue.400",
      "description": "Focus ring"
    },
    "destructive": {
      "light": "red.700",
      "dark": "red.400",
      "description": "Severity Critical · Offline · Resilience Weak · Control Failed"
    },
    "warning": {
      "light": "amber.700",
      "dark": "amber.400",
      "description": "Resilience Fair"
    },
    "success": {
      "light": "green.700",
      "dark": "green.400",
      "description": "Online · Resilience Strong · Control Passed"
    },
    "maintenance": {
      "light": "violet.700",
      "dark": "violet.400",
      "description": "Status Maintenance"
    },
    "severity-high": { "light": "orange.700", "dark": "orange.400" },
    "severity-medium": { "light": "yellow.700", "dark": "yellow.400" },
    "severity-low": { "light": "slate.700", "dark": "slate.400" },
    "kev": {
      "light": "magenta.700",
      "dark": "magenta.400",
      "description": "CISA Known Exploited Vulnerability"
    }
  },
  "alias": {
    "card-foreground": "foreground",
    "popover-foreground": "foreground",
    "secondary-foreground": "foreground",
    "accent-foreground": "foreground",
    "severity-critical": "destructive",
    "sidebar": "card",
    "sidebar-foreground": "foreground",
    "sidebar-primary": "primary",
    "sidebar-primary-foreground": "primary-foreground",
    "sidebar-accent": "accent",
    "sidebar-accent-foreground": "foreground",
    "sidebar-border": "border",
    "sidebar-ring": "ring"
  },
  "radius": "0.5rem",
  "text": {
    "body-sm": {
      "size": "13px",
      "lineHeight": "18px",
      "description": "Default table/data density"
    },
    "label": {
      "size": "11px",
      "lineHeight": "16px",
      "weight": 500,
      "tracking": "0.04em",
      "description": "Column headers, field labels (use with uppercase)"
    }
  },
  "shadow": {
    "sm": "0 1px 2px 0 rgb(0 0 0 / 0.12)",
    "md": "0 4px 12px -2px rgb(0 0 0 / 0.24)"
  }
}
